# Application
APP_ENV=local
LOG_LEVEL=INFO

# Self-managed service endpoints (local or Colab runtime)
OLLAMA_BASE_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333

# Models
MAIN_GENERATION_MODEL=qwen3:4b
MAIN_EMBEDDING_MODEL=nomic-embed-text-v1.5
SPARSE_EMBEDDING_MODEL=qdrant/bm25
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Rebuildable Qdrant collections
QDRANT_COLLECTION_PREFIX=askmydocs_documents
# Set to a Colab runtime path such as /content/qdrant_storage in Epics 2-6.
# Never set this to a mounted Drive path.
QDRANT_STORAGE_PATH=./.runtime/qdrant_storage

# Colab/Drive artifact boundary (configure per environment; do not commit secrets)
DRIVE_ARTIFACT_ROOT=/content/drive/MyDrive/AskMyDocs-RAG

# Configuration contracts
MODELS_CONFIG_PATH=configs/models.yaml
RETRIEVAL_CONFIG_PATH=configs/retrieval.yaml
INGESTION_PROFILE_PATH=configs/profiles/ingestion-index.yaml
QUERY_PROFILE_PATH=configs/profiles/query.yaml
RUN_MANIFEST_PATH=artifacts/run-manifest.json
PROMPTS_CONFIG_PATH=configs/prompts.yaml
EVALUATION_CONFIG_PATH=configs/evaluation.yaml

# Future semantic cache; not implemented in Phase 1
QDRANT_CACHE_COLLECTION=askmydocs_semantic_cache
